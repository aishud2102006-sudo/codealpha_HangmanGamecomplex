import random

# Categorized word bank with difficulties
CATEGORIES = {
    "animals": {
        "words": ["elephant", "kangaroo", "dolphin", "cheetah", "penguin"],
        "attempts": 6
    },
    "technology": {
        "words": ["algorithm", "database", "encryption", "framework", "syntax"],
        "attempts": 5
    },
    "geography": {
        "words": ["australia", "brazil", "madagascar", "switzerland", "japan"],
        "attempts": 6
    }
}

# ASCII art stages for Hangman
HANGMAN_PICS = [
    """
       ------
       |    |
            |
            |
            |
            |
    =========
    """,
    """
       ------
       |    |
       O    |
            |
            |
            |
    =========
    """,
    """
       ------
       |    |
       O    |
       |    |
            |
            |
    =========
    """,
    """
       ------
       |    |
       O    |
      /|    |
            |
            |
    =========
    """,
    """
       ------
       |    |
       O    |
      /|\\   |
            |
            |
    =========
    """,
    """
       ------
       |    |
       O    |
      /|\\   |
      /     |
            |
    =========
    """,
    """
       ------
       |    |
       O    |
      /|\\   |
      / \\   |
            |
    =========
    """
]


def display_game_status(attempts_left, max_attempts,
                        guessed_correct, guessed_wrong, display_word):
    # Display the correct Hangman stage
    pic_index = max_attempts - attempts_left
    pic_index = max(0, min(pic_index, len(HANGMAN_PICS) - 1))

    print(HANGMAN_PICS[pic_index])
    print(f"Word: {display_word}")

    print("Correct Guesses:",
          ", ".join(sorted(guessed_correct))
          if guessed_correct else "None")

    print("Wrong Guesses:",
          ", ".join(sorted(guessed_wrong))
          if guessed_wrong else "None")

    print(f"Attempts Left: {attempts_left}")


def play_hangman():
    print("\n========================================")
    print("       WELCOME TO ADVANCED HANGMAN")
    print("========================================")

    # Category selection
    print("\nSelect a Category:")

    categories = list(CATEGORIES.keys())

    for idx, cat in enumerate(categories, 1):
        print(
            f"  {idx}. {cat.capitalize()} "
            f"({len(CATEGORIES[cat]['words'])} words)"
        )

    while True:
        try:
            choice = int(input("Enter category number (1-3): "))

            if 1 <= choice <= len(categories):
                selected_category = categories[choice - 1]
                break

            print("Invalid selection. Choose a number from the list.")

        except ValueError:
            print("Please enter a valid integer.")

    # Initialize the game
    word_data = CATEGORIES[selected_category]
    word = random.choice(word_data["words"])
    max_attempts = word_data["attempts"]
    attempts = max_attempts

    guessed_correct = set()
    guessed_wrong = set()
    hints_remaining = 1

    # Main game loop
    while attempts > 0:

        # Build the displayed word
        display = " ".join(
            letter if letter in guessed_correct else "_"
            for letter in word
        )

        print("\n" + "~" * 40)

        display_game_status(
            attempts,
            max_attempts,
            guessed_correct,
            guessed_wrong,
            display
        )

        # Check whether the player has won
        if all(letter in guessed_correct for letter in word):
            print("\nCONGRATULATIONS! You guessed the word!")
            print(f"The word was: {word.upper()}")
            return

        print(
            f"\nOptions: Type a letter, 'hint' "
            f"({hints_remaining} left), or 'quit'."
        )

        guess = input("Your input: ").lower().strip()

        # Quit the game
        if guess == "quit":
            print("\nGame exited. Thanks for playing!")
            print(f"The hidden word was: {word.upper()}")
            return

        # Use a hint
        if guess == "hint":
            if hints_remaining > 0:
                unguessed_letters = [
                    letter for letter in word
                    if letter not in guessed_correct
                ]

                if unguessed_letters:
                    hint_letter = random.choice(unguessed_letters)
                    guessed_correct.add(hint_letter)
                    hints_remaining -= 1
                    attempts -= 1

                    print(
                        f"\nHINT REVEALED: The letter "
                        f"'{hint_letter}' is in the word!"
                    )
                    print("Penalty: -1 attempt")

                else:
                    print("\nYou already found all the letters!")

            else:
                print("\nYou have already used your hint!")

            continue

        # Validate letter input
        if len(guess) != 1 or not guess.isalpha():
            print(
                "\nInvalid input. Enter a single alphabetical letter."
            )
            continue

        # Check for repeated guesses
        if guess in guessed_correct or guess in guessed_wrong:
            print(
                f"\nYou already guessed '{guess}'. "
                "Try a different letter."
            )
            continue

        # Process the guess
        if guess in word:
            guessed_correct.add(guess)
            print(f"\nGood job! '{guess}' is in the word.")

        else:
            guessed_wrong.add(guess)
            attempts -= 1
            print(f"\nOops! '{guess}' is not in the word.")

    # Final word display and game-over message
    display = " ".join(
        letter if letter in guessed_correct else "_"
        for letter in word
    )

    print("\n" + "=" * 40)
    display_game_status(
        0,
        max_attempts,
        guessed_correct,
        guessed_wrong,
        display
    )
    print("GAME OVER! You ran out of attempts.")
    print(f"The secret word was: {word.upper()}")
    print("=" * 40)


# Main program
if __name__ == "__main__":
    while True:
        play_hangman()

        replay = input(
            "\nWould you like to play again? (y/n): "
        ).lower().strip()

        if replay != "y":
            print("\nThanks for playing! Goodbye.")
            break

